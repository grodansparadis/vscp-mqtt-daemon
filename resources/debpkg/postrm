#!/bin/sh
# postrm script for vscpd
#
# see: dh_installdeb(1)


set -e

case "$1" in
	purge)
		rm -rf /var/lib/vscp/mqttvscpd
		rm -f /var/log/vscp/mqttvscpd.log*
		if [ -d /var/log/vscp ]; then
			rmdir --ignore-fail-on-non-empty /var/log/vscp
		fi
		if [ -d /var/lib/vscp/web ]; then
			rmdir --ignore-fail-on-non-empty /var/lib/vscp/web
		fi
		if [ -d /usr/share/mqttvscp ]; then
			rmdir --ignore-fail-on-non-empty /usr/share/mqttvscp
		fi
		rm -rf /etc/vscp
        APP_PROFILE="usr.sbin.mqttvscpd"
        rm -f /etc/apparmor.d/disable/$APP_PROFILE >/dev/null 2>&1 || true
	;;
	remove|abort-install|abort-upgrade|disappear)
	;;

	upgrade|failed-upgrade)
	;;

	*)
		echo "postrm called with unknown argument \`$1'" >&2
		exit 1
	;;
esac

# Automatically added by dh_systemd_start
if [ -d /run/systemd/system ]; then
	systemctl --system daemon-reload >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_systemd_enable
if [ "$1" = "remove" ]; then
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper mask mqttvscpd.service >/dev/null
	fi
fi

if [ "$1" = "purge" ]; then
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper purge mqttvscpd.service >/dev/null
		deb-systemd-helper unmask mqttvscpd.service >/dev/null
	fi
fi
# End automatically added section

#DEBHELPER#

exit 0