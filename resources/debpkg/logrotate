/var/log/vscp/mqttvscpd-access.log {
	rotate 7
	daily
	compress
	size 100k
	nocreate
	missingok
	postrotate
		/usr/bin/killall -HUP mqttvscpd
	endscript
}

/var/log/vscp/mqttvscpd-error.log {
	rotate 7
	daily
	compress
	size 100k
	nocreate
	missingok
	postrotate
		/usr/bin/killall -HUP mqttvscpd
	endscript
}