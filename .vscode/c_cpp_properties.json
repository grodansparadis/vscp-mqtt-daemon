{
    "configurations": [
        {
            "name": "C/C++",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/third-party/json/include",
                "${workspaceFolder}/third-party/vscp/src/common",
                "${workspaceFolder}/third-party/vscp/src/vscp/common",
                "${workspaceFolder}/third-party/vscp/third-party/sqlite3",
                "${workspaceFolder}/third-party/vscp/third_party/maddy/include",
                "${workspaceFolder}/third-party/spdlog/include",
                "${workspaceFolder}/third-party/Mustache",
                "${workspaceFolder}/third-party/vscp/third_party/nlohmann/include"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++14",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": false
            },
            "compileCommands": [
                "${workspaceFolder}/build/compile_commands.json"
            ]
        }
