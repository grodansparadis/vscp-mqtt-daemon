{
    "configurations": [
        {
            "name": "C/C++",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/_deps/vscp-src/src/common",
                "${workspaceFolder}/build/_deps/vscp-src/src/vscp/common",
                "${workspaceFolder}/build/_deps/vscp_maddy-src/include",
                "${workspaceFolder}/build/_deps/vscp_spdlog-src/include",
                "${workspaceFolder}/build/_deps/vscp_mustache-src",
                "${workspaceFolder}/build/_deps/vscp_nlohmann_json-src/include"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++14",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": false
            },
            "compileCommands": [
                "${workspaceFolder}/build/compile_commands.json"
